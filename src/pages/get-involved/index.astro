---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/page/PageHero.astro";
import NextChapter from "../../components/page/NextChapter.astro";
import Container from "../../components/ui/Container.astro";
import type { NavigationLink } from "../../data/navigation";
import { nextPageAfter } from "../../data/navigation";
import { participationPathways } from "../../data/getInvolved";
import { slugify } from "../../utils/slugify";

// Each pathway points to the part of the site the brief already describes.
const relatedLinks: Record<string, NavigationLink> = {
  "Join a Cell": { label: "The Cell Ministry", href: "/ministries/#cell-ministry" },
  "Become a Volunteer": { label: "Volunteer registration", href: "/contact/#volunteer-registration" },
  "Serve in a Department": { label: "Our four departments", href: "/our-model/#pipeline" },
  "Attend Conferences": { label: "Major programs", href: "/programs/" },
  "Become a Ministry Partner": { label: "Partnership", href: "/contact/#partnership" },
  "Support Missions": { label: "Leadership, Deployment & Missions", href: "/our-model/#send" },
  "Enroll in Discipleship Training": { label: "School of Discipleship", href: "/ministries/#school-of-discipleship" },
};
const pathways = participationPathways.map((pathway) => ({
  ...pathway,
  id: slugify(pathway.label),
  related: relatedLinks[pathway.label],
}));
const next = nextPageAfter("/get-involved/");
---

<BaseLayout
  title="Get Involved"
  description="Join a cell, volunteer, serve in a department, attend conferences, partner with the ministry, support missions or enroll in discipleship training with Huios Transformation Mission."
  headerOverlay
>
  <PageHero
    page="Get Involved"
    title={["Become part", "of the mission."]}
    lead="There are multiple pathways to become part of the mission."
    chapters={pathways.map((pathway) => ({ id: pathway.id, label: pathway.label }))}
  />

  <section class="pathways" aria-labelledby="pathways-title">
    <h2 id="pathways-title" class="sr-only">Pathways</h2>
    <Container>
      <ol class="pathway-list">
        {pathways.map((pathway) => (
          <li id={pathway.id} class="pathway" data-reveal-group>
            <span class="pathway-number" aria-hidden="true" data-reveal-item>{pathway.number}</span>
            <h3 data-reveal-item style="--reveal-order: 1">{pathway.label}</h3>
            {pathway.related && (
              <a class="pathway-link" href={pathway.related.href} data-reveal-item style="--reveal-order: 2">
                {pathway.related.label} <span aria-hidden="true">→</span>
              </a>
            )}
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <NextChapter href={next.href} label={next.label} />
</BaseLayout>

<style>
  .pathways {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(5rem, 8vw, 8rem);
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .pathway-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pathway {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 1rem;
    padding-block: clamp(2rem, 3.5vw, 3.25rem);
    border-bottom: 1px solid var(--color-border);
  }

  .pathway-number {
    color: var(--color-earth);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .pathway h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.6vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .pathway-link {
    grid-column: 2;
    width: fit-content;
    color: var(--color-text-muted);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .pathway-link:hover {
    color: var(--color-earth);
    text-decoration: underline;
  }

  @media (min-width: 75rem) {
    .pathway {
      grid-template-columns: 4rem minmax(0, 1fr) auto;
    }

    .pathway-link {
      grid-column: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pathway-link {
      transition: none;
    }
  }
</style>
