---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import WhoWeAre from "../components/home/WhoWeAre.astro";
import Philosophy from "../components/home/Philosophy.astro";
import TransformationPipeline from "../components/home/TransformationPipeline.astro";
import VisionMission from "../components/home/VisionMission.astro";
import Departments from "../components/home/Departments.astro";
import Programs from "../components/home/Programs.astro";
import Ministries from "../components/home/Ministries.astro";
import Media from "../components/home/Media.astro";
import GetInvolved from "../components/home/GetInvolved.astro";
import Contact from "../components/home/Contact.astro";
import HomepageFinale from "../components/home/HomepageFinale.astro";
import { isDemo } from "../config/demo";
import { demoImages } from "../data/demo";

const heroImage = isDemo
  ? {
      src: demoImages.hero.src,
      webpSrcSet: demoImages.hero.webp,
      mobileSrcSet: demoImages.heroMobile.webp,
      sizes: "100vw",
    }
  : undefined;
const whoImage = isDemo
  ? { src: demoImages.gathering.src, webpSrcSet: demoImages.gathering.webp, alt: demoImages.gathering.alt }
  : undefined;
---

<BaseLayout
  title="Huios Transformation Mission"
  description="Huios Transformation Mission is an interdenominational discipling network raising mature sons to reveal Christ and transform nations."
  headerOverlay
>
  <Hero image={heroImage} />
  <WhoWeAre image={whoImage} />
  <Philosophy />
  <TransformationPipeline />
  <VisionMission />
  <Departments />
  <Programs />
  <Ministries />
  <Media />
  <GetInvolved />
  <Contact />
  <HomepageFinale />
</BaseLayout>

