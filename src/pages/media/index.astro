---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/page/PageHero.astro";
import Chapter from "../../components/page/Chapter.astro";
import NextChapter from "../../components/page/NextChapter.astro";
import { mediaCategories } from "../../data/media";
import { nextPageAfter } from "../../data/navigation";
import { slugify } from "../../utils/slugify";
import { isDemo } from "../../config/demo";
import { demoImages, demoMediaItems } from "../../data/demo";

const categories = mediaCategories.map((category) => ({ ...category, id: slugify(category.name) }));
const next = nextPageAfter("/media/");
const latest = isDemo
  ? demoMediaItems.map((item, index) => ({ ...item, image: demoImages.media[index] }))
  : [];
const chapters = [
  ...(latest.length ? [{ id: "latest", label: "Latest" }] : []),
  { id: "categories", label: "Media Categories" },
];
---

<BaseLayout
  title="Media"
  description="HUIOS TV and the media of Huios Transformation Mission: sermons, worship sessions, articles, devotionals, podcasts, conference messages, photo gallery and livestreams."
  headerOverlay
>
  <PageHero
    page="Media"
    eyebrow="HUIOS TV"
    title={["Watch.", "Listen.", "Explore."]}
    chapters={chapters}
  >
    <div slot="aside" class="tv-stage">
      <img
        src="/brand/huios-tv-white.png"
        width="1533"
        height="1533"
        alt="HUIOS TV"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </PageHero>

  {latest.length > 0 && (
    <Chapter id="latest" number="01" label="Latest" title={["Latest from", "HUIOS TV."]} tone="ink">
      <ul class="latest-grid" data-reveal-group>
        {latest.map((item, index) => (
          <li data-reveal-item style={`--reveal-order: ${index}`}>
            <article class="latest-item">
              <picture class="latest-thumb">
                <source type="image/webp" srcset={item.image.webp} />
                <img src={item.image.src} alt="" width="960" height="540" loading="lazy" decoding="async" />
                <span class="latest-play" aria-hidden="true">▶</span>
              </picture>
              <p class="latest-category">{item.category}</p>
              <h3>{item.title}</h3>
              <p class="latest-meta">{item.meta}</p>
            </article>
          </li>
        ))}
      </ul>
    </Chapter>
  )}

  <Chapter id="categories" number={latest.length ? "02" : "01"} label="Media Categories" title={["Watch, listen,", "and read."]}>
    <ul class="category-grid" data-reveal-group>
      {categories.map((category, index) => (
        <li id={category.id} data-reveal-item style={`--reveal-order: ${index % 4}`}>
          <span class="category-number" aria-hidden="true">{category.number}</span>
          <h3>{category.name}</h3>
        </li>
      ))}
    </ul>
  </Chapter>

  <NextChapter href={next.href} label={next.label} />
</BaseLayout>

<style>
  .tv-stage {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-ivory) 14%, transparent);
    background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--color-burnt) 22%, transparent), transparent 65%);
  }

  .tv-stage img {
    width: 72%;
    height: auto;
  }

  .latest-grid {
    display: grid;
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.25rem, 2.5vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .latest-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-charcoal);
  }

  .latest-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .latest-play {
    position: absolute;
    bottom: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--color-ember);
    color: var(--color-ink);
    font-size: 0.8rem;
  }

  .latest-category {
    margin: 1.25rem 0 0;
    color: var(--color-flame);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .latest-item h3 {
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.1vw, 2.1rem);
    font-weight: 500;
    line-height: 1.08;
  }

  .latest-meta {
    margin: 0.6rem 0 0;
    color: color-mix(in srgb, var(--color-ivory) 65%, transparent);
    font-size: 0.8rem;
  }

  @media (min-width: 48rem) {
    .latest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 75rem) {
    .latest-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .category-grid li {
    display: flex;
    min-height: clamp(10rem, 18vw, 16rem);
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.25rem, 2vw, 2rem);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .category-number {
    color: var(--color-earth);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .category-grid h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.6vw, 2.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  @media (min-width: 60rem) {
    .category-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 74.999rem) {
    .tv-stage {
      max-width: 16rem;
    }
  }
</style>
