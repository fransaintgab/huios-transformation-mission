---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import "@fontsource-variable/cormorant-garamond/wght.css";
import "@fontsource-variable/manrope/wght.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  headerOverlay?: boolean;
}

const { title, description, canonical: canonicalProp, headerOverlay = false } = Astro.props;
const pageTitle = title === "Huios Transformation Mission"
  ? title
  : `${title} | Huios Transformation Mission`;
const canonical = canonicalProp ?? (Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/brand/huios-logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Huios Transformation Mission" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header transparent={headerOverlay} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
