---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { missionLink, primaryNavigation } from "../../data/navigation";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header
  class:list={["site-header", { "site-header--overlay": transparent }]}
  data-scroll-header={transparent ? "" : undefined}
>
  <Container>
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Huios Transformation Mission home">
        <span class="brand-symbol" aria-hidden="true">
          <img src="/brand/huios-logo-white.png" width="3000" height="3000" alt="" />
        </span>
        <span class="brand-name">HUIOS<span>TRANSFORMATION MISSION</span></span>
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        <ul>
          {primaryNavigation.map((link) => (
            <li><a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="desktop-cta">
        <Button href={missionLink.href} class="header-action">
          {missionLink.label}<span aria-hidden="true">↗</span>
        </Button>
      </div>

      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span>Menu</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M3 7h18M3 17h18" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </Container>

  <dialog class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation">
    <div class="mobile-menu-inner">
      <div class="mobile-menu-top">
        <span>HUIOS</span>
        <button class="menu-close" type="button" aria-label="Close menu" data-close-menu>
          <span>CLOSE</span>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      </div>
      <nav aria-label="Mobile primary navigation">
        <ul>
          {primaryNavigation.map((link, index) => (
            <li>
              <span class="menu-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <Button href={missionLink.href} tone="light" class="mobile-action">
        JOIN THE MISSION <span aria-hidden="true">→</span>
      </Button>
    </div>
  </dialog>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-scroll-header]");
  const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");

  if (header) {
    const syncHeader = () => header.classList.toggle("is-scrolled", window.scrollY > 64);
    syncHeader();
    window.addEventListener("scroll", syncHeader, { passive: true });
  }

  if (toggle && menu) {
    const closeMenu = () => menu.close();

    toggle.addEventListener("click", () => {
      menu.showModal();
      toggle.setAttribute("aria-expanded", "true");
      document.body.classList.add("menu-open");
    });
    menu.addEventListener("close", () => {
      toggle.setAttribute("aria-expanded", "false");
      document.body.classList.remove("menu-open");
      if (toggle.getClientRects().length) toggle.focus();
      else document.querySelector<HTMLAnchorElement>(".site-header .brand")?.focus();
    });
    menu.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest("[data-close-menu]")) closeMenu();
      else if (event.target.closest("a")) window.setTimeout(closeMenu, 0);
    });
    window.matchMedia("(min-width: 75rem)").addEventListener("change", (event) => {
      if (event.matches && menu.open) closeMenu();
    });
  }
</script>

<style>
  .site-header {
    --focus-color: var(--color-flame);
    --button-hover-color: var(--color-flame);
    position: relative;
    z-index: 20;
    width: 100%;
    border-bottom: 1px solid transparent;
    background: var(--color-ink);
    color: var(--color-ivory);
    transition: background-color 220ms ease, border-color 220ms ease;
  }

  .site-header--overlay {
    position: fixed;
    inset: 0 0 auto;
    background: transparent;
  }

  .site-header--overlay.is-scrolled {
    border-color: color-mix(in srgb, var(--color-ivory) 13%, transparent);
    background: color-mix(in srgb, var(--color-ink) 91%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2vw, 2.5rem);
    min-height: 6rem;
    transition: min-height 220ms ease;
  }

  .is-scrolled .header-inner {
    min-height: 5rem;
  }

  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    text-decoration: none;
  }

  /* Display the supplied flame and book without its duplicate embedded wordmark. */
  .brand-symbol {
    position: relative;
    display: block;
    flex: none;
    width: 4rem;
    height: 2.75rem;
    overflow: hidden;
  }

  .brand-symbol img {
    position: absolute;
    top: -1.2rem;
    left: -1.33rem;
    width: 6.67rem;
    max-width: none;
    height: auto;
  }

  .brand-name {
    display: grid;
    gap: 0.2rem;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    line-height: 1;
  }

  .brand-name span {
    font-size: 0.47rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    white-space: nowrap;
  }

  .desktop-nav,
  .desktop-cta {
    display: none;
  }

  .desktop-nav ul,
  .mobile-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-toggle,
  .menu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-toggle,
  .menu-close span {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mobile-menu {
    --focus-color: var(--color-flame);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(1.25rem, 4vw, 4.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    background: var(--color-charcoal);
    color: var(--color-ivory);
  }

  .mobile-menu[open] {
    animation: menu-reveal 200ms ease-out both;
  }

  .mobile-menu-inner {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(2rem, 7vh, 4.5rem);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .mobile-menu nav {
    max-width: 70rem;
  }

  .mobile-menu nav li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: baseline;
    gap: clamp(0.8rem, 2vw, 1.5rem);
    border-bottom: 1px solid color-mix(in srgb, var(--color-ivory) 13%, transparent);
  }

  .menu-index {
    color: var(--color-flame);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .mobile-menu nav a {
    display: block;
    width: fit-content;
    padding-block: 0.38rem;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5vw, 3.75rem);
    font-weight: 500;
    line-height: 1.05;
    text-decoration: none;
    transition: color 180ms ease, transform 180ms ease;
  }

  .mobile-menu nav a[aria-current="page"] {
    color: var(--color-flame);
  }

  .mobile-menu nav a:hover {
    color: var(--color-flame);
    transform: translateX(4px);
  }

  .mobile-menu :global(.mobile-action) {
    min-height: 3rem;
    margin-top: clamp(2rem, 5vh, 3.5rem);
    padding-inline: 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.09em;
  }

  @keyframes menu-reveal {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 75rem) {
    .desktop-nav {
      display: block;
      margin-left: auto;
    }

    .desktop-nav ul {
      display: flex;
      align-items: center;
      gap: clamp(1.25rem, 1.9vw, 2.25rem);
    }

    .desktop-nav a {
      position: relative;
      display: inline-block;
      padding-block: 0.4rem;
      color: var(--color-ivory);
      font-size: 0.72rem;
      font-weight: 700;
      white-space: nowrap;
      text-decoration: none;
      transition: color 180ms ease;
    }

    .desktop-nav a::after {
      position: absolute;
      right: 0;
      bottom: 0.12rem;
      left: 0;
      height: 1px;
      background: var(--color-flame);
      content: "";
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 180ms ease;
    }

    .desktop-nav a:hover,
    .desktop-nav a:focus-visible {
      color: var(--color-white);
    }

    .desktop-nav a:hover::after,
    .desktop-nav a:focus-visible::after,
    .desktop-nav a[aria-current="page"]::after {
      transform: scaleX(1);
    }

    .desktop-cta {
      display: block;
    }

    .desktop-cta :global(.header-action) {
      min-height: 2.65rem;
      padding-inline: 1.1rem;
    }

    .menu-toggle {
      display: none;
    }
  }

  @media (max-width: 74.999rem) {
    .header-inner {
      min-height: 4.25rem;
    }

    .is-scrolled .header-inner {
      min-height: 4rem;
    }
  }

  @media (max-height: 42rem) {
    .mobile-menu-top {
      margin-bottom: 1.5rem;
    }

    .mobile-menu nav a {
      padding-block: 0.22rem;
      font-size: clamp(1.8rem, 5vh, 2.5rem);
    }

    .mobile-menu :global(.mobile-action) {
      margin-top: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .header-inner,
    .desktop-nav a,
    .desktop-nav a::after,
    .mobile-menu nav a {
      transition: none;
    }

    .mobile-menu[open] {
      animation: none;
    }
  }
</style>
