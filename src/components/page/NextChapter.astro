---
import Container from "../ui/Container.astro";

interface Props {
  href: string;
  label: string;
  eyebrow?: string;
}

const { href, label, eyebrow = "Continue" } = Astro.props;
---

<nav class="next-chapter" aria-label="Continue reading">
  <Container>
    <a href={href} class="next-link" data-reveal-group>
      <span class="next-eyebrow" data-reveal-item>{eyebrow}</span>
      <span class="next-label" data-reveal-item style="--reveal-order: 1">
        <span>{label}</span>
        <span class="next-arrow" aria-hidden="true">→</span>
      </span>
    </a>
  </Container>
</nav>

<style>
  .next-chapter {
    --focus-color: var(--color-flame);
    border-top: 1px solid color-mix(in srgb, var(--color-ivory) 10%, transparent);
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .next-link {
    display: grid;
    gap: clamp(1.25rem, 2vw, 2rem);
    padding-block: clamp(4.5rem, 8vw, 8rem);
    text-decoration: none;
  }

  .next-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .next-eyebrow::before {
    flex: none;
    width: 1.5rem;
    height: 1px;
    background: var(--color-flame);
    content: "";
  }

  .next-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 8vw, 8.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
    transition: color 200ms ease;
  }

  .next-arrow {
    flex: none;
    color: var(--color-flame);
    font-family: var(--font-body);
    font-size: 0.45em;
    font-weight: 300;
    transition: transform 220ms ease;
  }

  .next-link:hover .next-label {
    color: var(--color-flame);
  }

  .next-link:hover .next-arrow,
  .next-link:focus-visible .next-arrow {
    transform: translateX(0.35em);
  }

  @media (prefers-reduced-motion: reduce) {
    .next-label,
    .next-arrow {
      transition: none;
    }
  }
</style>
