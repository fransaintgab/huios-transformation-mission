---
import Container from "../ui/Container.astro";

export interface PageChapter {
  readonly id: string;
  readonly label: string;
}

interface Props {
  /** Short page name, shown in the breadcrumb and the eyebrow. */
  page: string;
  eyebrow?: string;
  /** Headline lines; each renders on its own line on wide screens. */
  title: readonly string[];
  lead?: string;
  chapters?: readonly PageChapter[];
}

const { page, eyebrow = page, title, lead, chapters = [] } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<section class:list={["page-hero", { "page-hero--aside": hasAside }]} aria-labelledby="page-title">
  <div class="page-hero-atmosphere" aria-hidden="true"></div>

  <Container class="page-hero-container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">{page}</li>
      </ol>
    </nav>

    <div class="page-hero-grid">
      <div class="page-hero-copy">
        <p class="page-eyebrow"><span aria-hidden="true"></span>{eyebrow}</p>
        <h1 id="page-title">
          {title.map((line) => <span>{line} </span>)}
        </h1>
      </div>

      {lead && <p class="page-lead">{lead}</p>}

      {hasAside && (
        <div class="page-hero-aside">
          <slot name="aside" />
        </div>
      )}
    </div>

    {chapters.length > 0 && (
      <nav class="chapter-rail" aria-label="On this page">
        <p class="rail-label" aria-hidden="true">On this page</p>
        <ol>
          {chapters.map((chapter, index) => (
            <li>
              <a href={`#${chapter.id}`}>
                <span class="rail-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                {chapter.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </Container>
</section>

<style>
  .page-hero {
    --focus-color: var(--color-flame);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  /* Same restrained atmosphere as the homepage hero placeholder. */
  .page-hero-atmosphere {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(ellipse at 88% 30%, color-mix(in srgb, var(--color-burnt) 16%, transparent), transparent 55%),
      linear-gradient(115deg, var(--color-ink) 20%, var(--color-charcoal) 70%, color-mix(in srgb, var(--color-charcoal) 90%, var(--color-burnt)) 100%);
  }

  :global(.page-hero-container) {
    display: grid;
    min-height: min(52rem, 88svh);
    grid-template-rows: auto 1fr auto;
    padding-top: clamp(7.5rem, 13vh, 10rem);
    padding-bottom: clamp(2rem, 3vw, 3rem);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: color-mix(in srgb, var(--color-ivory) 70%, transparent);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .breadcrumb li + li::before {
    margin-right: 0.6rem;
    color: var(--color-flame);
    content: "/";
  }

  .breadcrumb a {
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-flame);
  }

  .breadcrumb [aria-current] {
    color: var(--color-ivory);
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(2rem, 4vw, 3rem);
    align-items: end;
    padding-block: clamp(4rem, 9vh, 7rem) clamp(3.5rem, 7vh, 5.5rem);
  }

  .page-hero-copy {
    grid-column: 1 / span 8;
    min-width: 0;
  }

  .page-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0 0 clamp(1.4rem, 3vh, 2.25rem);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.45;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    animation: page-enter 650ms cubic-bezier(0.22, 1, 0.36, 1) 60ms both;
  }

  .page-eyebrow span {
    flex: none;
    width: 1.5rem;
    height: 1px;
    background: var(--color-flame);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7.2vw, 7.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-wrap: initial;
    animation: page-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) 140ms both;
  }

  h1 span {
    display: block;
  }

  .page-lead {
    grid-column: 9 / span 4;
    max-width: 26rem;
    margin: 0 0 0.35rem;
    color: color-mix(in srgb, var(--color-ivory) 86%, transparent);
    font-size: clamp(1rem, 1.15vw, 1.1rem);
    line-height: 1.75;
    animation: page-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) 230ms both;
  }

  .page-hero-aside {
    grid-column: 9 / span 4;
    align-self: center;
    animation: page-enter 800ms cubic-bezier(0.22, 1, 0.36, 1) 260ms both;
  }

  .chapter-rail {
    display: grid;
    gap: 1rem;
    padding-top: 1.35rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ivory) 16%, transparent);
    animation: page-enter 650ms cubic-bezier(0.22, 1, 0.36, 1) 360ms both;
  }

  .rail-label {
    margin: 0;
    color: color-mix(in srgb, var(--color-ivory) 62%, transparent);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .chapter-rail ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem clamp(1.25rem, 2.6vw, 2.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chapter-rail a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    padding-block: 0.3rem;
    color: var(--color-ivory);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .chapter-rail a:hover {
    color: var(--color-flame);
  }

  .rail-number {
    color: var(--color-flame);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  @keyframes page-enter {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 75rem) {
    .chapter-rail {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  @media (max-width: 74.999rem) {
    .page-hero-copy,
    .page-lead,
    .page-hero-aside {
      grid-column: 1 / -1;
    }

    .page-lead {
      max-width: 36rem;
    }

    .page-hero--aside .page-hero-aside {
      max-width: 22rem;
    }
  }

  @media (max-width: 47.999rem) {
    :global(.page-hero-container) {
      min-height: 0;
      padding-top: 6.25rem;
    }

    .page-hero-grid {
      padding-block: 3.5rem 3rem;
    }

    .page-eyebrow {
      gap: 0.6rem;
      font-size: 0.6rem;
      letter-spacing: 0.14em;
    }

    .page-eyebrow span {
      width: 1rem;
    }

    h1 {
      font-size: clamp(3rem, 12.5vw, 4.5rem);
      line-height: 0.93;
    }

    .page-lead {
      font-size: 0.97rem;
    }

    .chapter-rail ol {
      flex-direction: column;
      gap: 0.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-eyebrow,
    h1,
    .page-lead,
    .page-hero-aside,
    .chapter-rail {
      animation: none;
    }
  }
</style>
