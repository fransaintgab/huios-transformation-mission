---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { mediaCategories } from "../../data/media";
import { slugify } from "../../utils/slugify";
---

<section class="media" aria-labelledby="media-title">
  <Container>
    <div class="media-intro" data-reveal-group>
      <h2 id="media-title" class="visually-hidden">Media</h2>
      <div class="media-marker" data-reveal>
        <Eyebrow>09 / MEDIA</Eyebrow>
      </div>
      <p class="intro-heading" data-reveal>
        <span>Watch.</span>
        <span>Listen.</span>
        <span>Explore.</span>
      </p>
    </div>

    <div class="canvas-reveal" data-reveal-group>
      <div class="tv-canvas" data-reveal>
        <img
          src="/brand/huios-tv-white.png"
          width="1533"
          height="1533"
          alt="HUIOS TV"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <ul class="media-categories" data-reveal-group>
      {mediaCategories.map((category) => (
        <li>
          <span class="category-number" aria-hidden="true">{category.number}</span>
          <a class="category-name" href={`/media/#${slugify(category.name)}`}>{category.name}</a>
        </li>
      ))}
    </ul>

    <div class="media-cta" data-reveal-group>
      <div data-reveal>
        <Button href="/media/" variant="text">
          EXPLORE MEDIA <span aria-hidden="true">→</span>
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Links to the matching section on the inner page; styled like the approved list items. */
  a.category-name {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  a.category-name:hover {
    color: var(--color-earth);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .media {
    --button-hover-color: var(--color-earth);
    padding-block: clamp(6rem, 8.5vw, 9rem) clamp(7rem, 9vw, 10rem);
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .media-marker {
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .media-marker :global(.eyebrow) {
    color: var(--color-earth);
  }

  .intro-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 6.5vw, 7.5rem);
    font-weight: 500;
    line-height: 0.91;
    letter-spacing: -0.035em;
  }

  .intro-heading span {
    display: block;
  }

  .canvas-reveal {
    margin-top: clamp(5rem, 8vw, 8rem);
  }

  .tv-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 2.15;
    overflow: hidden;
    background: var(--color-charcoal);
  }

  .tv-canvas img {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: min(78%, 56rem);
    max-width: none;
    height: auto;
    transform: translate(-50%, -50%);
  }

  .media-categories {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    margin: clamp(5rem, 7vw, 7rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .media-categories li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: baseline;
    min-width: 0;
    padding-block: clamp(1.5rem, 2.25vw, 2.25rem);
    border-top: 1px solid var(--color-border);
  }

  .media-categories li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .category-number {
    color: var(--color-earth);
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.16em;
  }

  .category-name {
    min-width: 0;
    font-size: clamp(1.15rem, 1.8vw, 1.75rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .media-cta {
    margin-top: clamp(3.5rem, 5vw, 5rem);
  }

  .media-cta :global(.button--text) {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .media-intro [data-reveal],
  .canvas-reveal [data-reveal],
  .media-categories,
  .media-cta [data-reveal] {
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .media-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
  .canvas-reveal.is-reveal-pending:not(.is-revealed) [data-reveal],
  .media-categories.is-reveal-pending:not(.is-revealed),
  .media-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
  }

  .intro-heading {
    transition-delay: 80ms;
  }

  @media (min-width: 60rem) {
    .media-categories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(3rem, 6vw, 7rem);
    }

    .media-categories li:nth-last-child(2) {
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 59.999rem) {
    .tv-canvas {
      aspect-ratio: 1.6;
    }
  }

  @media (max-width: 47.999rem) {
    .media {
      padding-block: 5.5rem 6rem;
    }

    .media-marker {
      margin-bottom: 3rem;
    }

    .intro-heading {
      font-size: clamp(3.75rem, 13vw, 5.5rem);
    }

    .canvas-reveal {
      margin-top: 4.5rem;
    }

    .tv-canvas {
      aspect-ratio: 1.25;
    }

    .tv-canvas img {
      width: min(100%, 28rem);
    }

    .media-categories {
      margin-top: 4.5rem;
    }

    .media-categories li {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 1rem;
      padding-block: 1.55rem 1.7rem;
    }

    .media-cta {
      margin-top: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media-intro [data-reveal],
    .canvas-reveal [data-reveal],
    .media-categories,
    .media-cta [data-reveal] {
      transition: none;
    }

    .media-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
    .canvas-reveal.is-reveal-pending:not(.is-revealed) [data-reveal],
    .media-categories.is-reveal-pending:not(.is-revealed),
    .media-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
