---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { primaryNavigation } from "../../data/navigation";
import { programs } from "../../data/programs";
---

<section class="programs" aria-labelledby="programs-title">
  <Container>
    <div class="programs-intro" data-reveal-group>
      <h2 id="programs-title" class="visually-hidden">Major Programs</h2>
      <div class="programs-marker" data-reveal>
        <Eyebrow>07 / MAJOR PROGRAMS</Eyebrow>
      </div>
      <p class="intro-heading" data-reveal>Gatherings for transformation.</p>
    </div>

    <ol class="program-list">
      {programs.map((program) => (
        <li class="program-item" data-reveal-group>
          <article data-reveal>
            <span class="program-number" aria-hidden="true">{program.number}</span>
            <h3>{program.name}</h3>
            <p class="program-description">{program.description}</p>
          </article>
        </li>
      ))}
    </ol>

    <div class="programs-cta" data-reveal-group>
      <div data-reveal>
        <Button href={primaryNavigation[3].href} variant="text">
          EXPLORE ALL PROGRAMS <span aria-hidden="true">→</span>
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .programs {
    --button-hover-color: var(--color-earth);
    padding-block: clamp(6rem, 8.5vw, 9rem) clamp(7rem, 9vw, 10rem);
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .programs-marker {
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .programs-marker :global(.eyebrow) {
    color: var(--color-earth);
  }

  .intro-heading {
    max-width: 60rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.75rem, 6vw, 6.5rem);
    font-weight: 500;
    line-height: 0.93;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .program-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    margin: clamp(5rem, 7vw, 7rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .program-item {
    min-width: 0;
    padding-block: clamp(2.75rem, 4vw, 4rem);
    border-top: 1px solid var(--color-border);
  }

  .program-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .program-number {
    color: var(--color-earth);
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.16em;
  }

  h3 {
    margin: clamp(1.5rem, 2vw, 2rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 3.5vw, 4.25rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .program-description {
    max-width: 35rem;
    margin: clamp(1.5rem, 2vw, 2rem) 0 0;
    font-size: clamp(1rem, 1.15vw, 1.125rem);
    line-height: 1.72;
  }

  .programs-cta {
    margin-top: clamp(3.5rem, 5vw, 5rem);
  }

  .programs-cta :global(.button--text) {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .programs-intro [data-reveal],
  .program-item [data-reveal],
  .programs-cta [data-reveal] {
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .programs-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
  .program-item.is-reveal-pending:not(.is-revealed) [data-reveal],
  .programs-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
  }

  .intro-heading {
    transition-delay: 80ms;
  }

  @media (min-width: 60rem) {
    .program-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(3rem, 6vw, 7rem);
    }

    .program-item:nth-last-child(2) {
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 47.999rem) {
    .programs {
      padding-block: 5.5rem 6rem;
    }

    .programs-marker {
      margin-bottom: 3rem;
    }

    .intro-heading {
      font-size: clamp(3.35rem, 11vw, 4.8rem);
    }

    .program-list {
      margin-top: 4.5rem;
    }

    .program-item {
      padding-block: 2.8rem 3rem;
    }

    h3 {
      font-size: clamp(2.75rem, 9vw, 3.75rem);
    }

    .program-description {
      margin-top: 1.5rem;
      font-size: 1rem;
    }

    .programs-cta {
      margin-top: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .programs-intro [data-reveal],
    .program-item [data-reveal],
    .programs-cta [data-reveal] {
      transition: none;
    }

    .programs-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
    .program-item.is-reveal-pending:not(.is-revealed) [data-reveal],
    .programs-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
