---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { visionMission } from "../../data/visionMission";
---

<!-- Homepage teaser: the vision in full, the mission's eight pillars on /about/. -->
<section class="vision-mission" aria-labelledby="vision-mission-title">
  <Container>
    <h2 id="vision-mission-title" class="sr-only">Vision &amp; Mission</h2>
    <div class="vision-group" data-reveal-group>
      <div class="section-marker" data-reveal-item>
        <Eyebrow>05 / VISION &amp; MISSION</Eyebrow>
      </div>
      <h3 class="subsection-label" data-reveal-item style="--reveal-order: 1">Our Vision</h3>
      <p class="vision-statement" data-reveal-item style="--reveal-order: 2">{visionMission.vision}</p>
    </div>

    <div class="mission-row" data-reveal-group>
      <div data-reveal-item>
        <h3 class="subsection-label">Our Mission</h3>
        <p class="mission-statement">{visionMission.mission.statement.replace(/:$/, "")}.</p>
      </div>
      <div class="mission-cta" data-reveal-item style="--reveal-order: 1">
        <Button href="/about/#mission" variant="text">
          THE EIGHT PILLARS <span aria-hidden="true">→</span>
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .vision-mission {
    --button-hover-color: var(--color-earth);
    padding-block: clamp(6rem, 8vw, 9rem);
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .section-marker {
    margin-bottom: clamp(4rem, 6vw, 7rem);
  }

  .section-marker :global(.eyebrow) {
    color: var(--color-earth);
  }

  .subsection-label {
    margin: 0;
    color: var(--color-earth);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .vision-statement {
    max-width: 72rem;
    margin: clamp(2rem, 3vw, 3.5rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 6.4vw, 6.5rem);
    font-weight: 500;
    line-height: 0.91;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .mission-row {
    display: grid;
    gap: 2rem;
    align-items: end;
    margin-top: clamp(4.5rem, 7vw, 7rem);
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    border-top: 1px solid var(--color-border);
  }

  .mission-statement {
    max-width: 40rem;
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.2vw, 3.4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .mission-cta :global(.button--text) {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  @media (min-width: 60rem) {
    .mission-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
