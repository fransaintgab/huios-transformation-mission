---
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { visionMission } from "../../data/visionMission";
---

<section class="vision-mission" aria-labelledby="vision-mission-title">
  <Container>
    <h2 id="vision-mission-title" class="visually-hidden">Vision &amp; Mission</h2>

    <div class="vision-group" data-reveal-group>
      <div class="section-marker" data-reveal>
        <Eyebrow>05 / VISION &amp; MISSION</Eyebrow>
      </div>

      <div class="vision-content">
        <h3 class="subsection-label" data-reveal>Our Vision</h3>
        <p class="vision-statement" data-reveal>{visionMission.vision}</p>
      </div>
    </div>

    <div class="mission-group" data-reveal-group>
      <div class="mission-divider" data-reveal aria-hidden="true"></div>

      <div class="mission-grid">
        <div class="mission-intro" data-reveal>
          <h3 class="subsection-label">Our Mission</h3>
          <p class="mission-statement">{visionMission.mission.statement}</p>
        </div>

        <ol class="pillars" data-reveal>
          {visionMission.mission.pillars.map((pillar, index) => (
            <li>
              <span class="pillar-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="pillar-label">{pillar}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Container>
</section>

<style>
  .vision-mission {
    padding-block: clamp(6rem, 8vw, 9rem) clamp(7rem, 9vw, 10rem);
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .section-marker {
    margin-bottom: clamp(4rem, 6vw, 7rem);
  }

  .section-marker :global(.eyebrow) {
    color: var(--color-earth);
  }

  .subsection-label {
    margin: 0;
    color: var(--color-earth);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .vision-statement {
    max-width: 72rem;
    margin: clamp(2rem, 3vw, 3.5rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(4.75rem, 6.4vw, 6.5rem);
    font-weight: 500;
    line-height: 0.91;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .mission-group {
    margin-top: clamp(6.5rem, 10vw, 11rem);
  }

  .mission-divider {
    height: 1px;
    margin-bottom: clamp(4rem, 6vw, 6rem);
    background: var(--color-border);
  }

  .mission-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
  }

  .mission-intro {
    grid-column: 1 / span 5;
    min-width: 0;
  }

  .mission-statement {
    max-width: 31rem;
    margin: clamp(1.7rem, 2.5vw, 2.6rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 3.7vw, 4.6rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .pillars {
    grid-column: 7 / span 6;
    display: grid;
    grid-auto-flow: column;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(4, auto);
    column-gap: clamp(1.5rem, 2.5vw, 3rem);
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillars li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    align-content: start;
    column-gap: 0.6rem;
    min-width: 0;
    padding-block: 1.2rem 1.55rem;
    border-top: 1px solid var(--color-border);
  }

  .pillars li:nth-child(4),
  .pillars li:nth-child(8) {
    border-bottom: 1px solid var(--color-border);
  }

  .pillar-number {
    padding-top: 0.18rem;
    color: var(--color-earth);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: 0.1em;
  }

  .pillar-label {
    font-size: clamp(0.92rem, 1.05vw, 1.04rem);
    font-weight: 650;
    line-height: 1.5;
  }

  .vision-mission [data-reveal] {
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .vision-mission [data-reveal-group].is-reveal-pending:not(.is-revealed) [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
  }

  .vision-content .subsection-label,
  .mission-intro {
    transition-delay: 70ms;
  }

  .vision-statement,
  .pillars {
    transition-delay: 140ms;
  }

  @media (max-width: 74.999rem) {
    .mission-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(3.5rem, 5vw, 5rem);
    }

    .mission-intro,
    .pillars {
      grid-column: 1;
    }

    .mission-statement {
      max-width: 42rem;
    }

    .pillar-label {
      font-size: 1rem;
    }
  }

  @media (max-width: 47.999rem) {
    .vision-mission {
      padding-block: 5.5rem 6rem;
    }

    .section-marker {
      margin-bottom: 3.5rem;
    }

    .vision-statement {
      width: min(calc(100% + 1rem), calc(100vw - var(--page-gutter) - 1rem));
      margin-top: 1.9rem;
      font-size: clamp(2.75rem, 11vw, 4.6rem);
      line-height: 0.94;
      letter-spacing: -0.035em;
      text-wrap: balance;
    }

    .mission-group {
      margin-top: 5.5rem;
    }

    .mission-divider {
      margin-bottom: 4rem;
    }

    .mission-grid {
      row-gap: 3.875rem;
    }

    .mission-statement {
      margin-top: 1.7rem;
      font-size: clamp(2.6rem, 9vw, 3.8rem);
    }

    .pillars {
      grid-auto-flow: row;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }

    .pillars li {
      padding-block: 1.1rem 1.4rem;
    }

    .pillars li:nth-child(4) {
      border-bottom: 0;
    }
  }

  @media (max-width: 24rem) {
    .vision-statement {
      letter-spacing: -0.045em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vision-mission [data-reveal] {
      transition: none;
    }

    .vision-mission [data-reveal-group].is-reveal-pending:not(.is-revealed) [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
