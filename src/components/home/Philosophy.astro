---
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
---

<section class="philosophy" aria-labelledby="philosophy-title" data-reveal-group>
  <Container class="philosophy-container">
    <div class="philosophy-marker" data-reveal>
      <Eyebrow>03 / OUR PHILOSOPHY</Eyebrow>
    </div>

    <div class="philosophy-content">
      <h2 id="philosophy-title">
        <span data-reveal>Transformation </span>
        <span data-reveal>precedes </span>
        <span data-reveal>manifestation.</span>
      </h2>

      <p data-reveal>
        Our focus is not merely gathering crowds but building disciples. Every believer is called to mature into sonship, serve faithfully, develop leadership capacity, and ultimately become a kingdom influence.
      </p>
    </div>
  </Container>
</section>

<style>
  .philosophy {
    --focus-color: var(--color-flame);
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  :global(.philosophy-container) {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 85svh;
    padding-block: clamp(6rem, 9vw, 10rem);
  }

  .philosophy-marker :global(.eyebrow) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-ivory);
  }

  .philosophy-marker :global(.eyebrow)::before {
    flex: none;
    width: 1.5rem;
    height: 1px;
    background: var(--color-flame);
    content: "";
  }

  .philosophy-content {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    column-gap: clamp(1rem, 2vw, 2rem);
    padding-top: clamp(4.5rem, 8vw, 8rem);
  }

  h2 {
    grid-column: 1 / span 9;
    min-width: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 8vw, 9rem);
    font-weight: 500;
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-wrap: initial;
  }

  h2 span {
    display: block;
  }

  .philosophy-content p {
    grid-column: 10 / span 3;
    max-width: 24rem;
    margin: 0 0 0.2rem;
    color: color-mix(in srgb, var(--color-ivory) 84%, transparent);
    font-size: clamp(1rem, 1.1vw, 1.125rem);
    line-height: 1.75;
  }

  .philosophy [data-reveal] {
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .philosophy.is-reveal-pending:not(.is-revealed) [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
  }

  h2 span:nth-child(1) {
    transition-delay: 80ms;
  }

  h2 span:nth-child(2) {
    transition-delay: 170ms;
  }

  h2 span:nth-child(3) {
    transition-delay: 260ms;
  }

  .philosophy-content p {
    transition-delay: 350ms;
  }

  @media (max-width: 74.999rem) {
    .philosophy-content {
      grid-template-columns: minmax(0, 1fr);
      row-gap: clamp(3.5rem, 7vw, 5.5rem);
    }

    h2,
    .philosophy-content p {
      grid-column: 1;
    }

    h2 {
      font-size: clamp(4.25rem, 8.5vw, 7rem);
    }

    .philosophy-content p {
      max-width: 34rem;
      margin-left: auto;
    }
  }

  @media (max-width: 47.999rem) {
    :global(.philosophy-container) {
      min-height: 0;
      padding-block: 6rem;
    }

    .philosophy-content {
      row-gap: 3rem;
      padding-top: 4.5rem;
    }

    h2 {
      font-size: clamp(3.25rem, 12vw, 4.75rem);
      line-height: 0.88;
    }

    .philosophy-content p {
      margin-left: 0;
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .philosophy [data-reveal] {
      transition: none;
    }

    .philosophy.is-reveal-pending:not(.is-revealed) [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
