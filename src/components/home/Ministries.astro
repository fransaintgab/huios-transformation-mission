---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { primaryNavigation } from "../../data/navigation";
import { cellMinistry, ministries } from "../../data/ministries";
---

<section class="ministries" aria-labelledby="ministries-title">
  <Container>
    <div class="ministries-grid">
      <div class="ministries-intro" data-reveal-group>
        <h2 id="ministries-title" class="visually-hidden">Ministries</h2>
        <div class="ministries-marker" data-reveal>
          <Eyebrow>08 / MINISTRIES</Eyebrow>
        </div>
        <p class="intro-heading" data-reveal>
          <span>One mission.</span>
          <span>Many expressions.</span>
        </p>
      </div>

      <ol class="ministry-list" data-reveal-group>
        {ministries.map((ministry) => (
          <li>
            <span class="ministry-number" aria-hidden="true">{ministry.number}</span>
            <span class="ministry-name">{ministry.name}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="cell-spotlight" data-reveal-group>
      <div class="cell-intro" data-reveal>
        <Eyebrow>CELL MINISTRY</Eyebrow>
        <h3>Across every department.</h3>
      </div>

      <div class="cell-content" data-reveal>
        <p>{cellMinistry.statement}</p>
        <ul class="cell-roles">
          {cellMinistry.roles.map((role) => <li>{role}</li>)}
        </ul>
      </div>
    </div>

    <div class="ministries-cta" data-reveal-group>
      <div data-reveal>
        <Button href={primaryNavigation[2].href} variant="text">
          EXPLORE MINISTRIES <span aria-hidden="true">→</span>
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .ministries {
    --focus-color: var(--color-flame);
    --button-hover-color: var(--color-flame);
    padding-block: clamp(6rem, 8.5vw, 9rem) clamp(7rem, 9vw, 10rem);
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ministries-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(5rem, 8vw, 8rem);
    align-items: start;
  }

  .ministries-marker {
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .ministries-marker :global(.eyebrow) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-ivory);
  }

  .ministries-marker :global(.eyebrow)::before {
    flex: none;
    width: 1.5rem;
    height: 1px;
    background: var(--color-flame);
    content: "";
  }

  .intro-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.75rem, 6vw, 6.5rem);
    font-weight: 500;
    line-height: 0.93;
    letter-spacing: -0.035em;
  }

  .intro-heading span {
    display: block;
  }

  .ministry-list {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ministry-list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: baseline;
    min-width: 0;
    padding-block: clamp(1.75rem, 2.4vw, 2.5rem);
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
  }

  .ministry-list li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
  }

  .ministry-number {
    color: var(--color-flame);
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.16em;
  }

  .ministry-name {
    min-width: 0;
    font-family: var(--font-display);
    font-size: clamp(2.65rem, 3.8vw, 4.75rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .cell-spotlight {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 5vw, 6rem);
    margin-top: clamp(7rem, 10vw, 11rem);
    padding-top: clamp(4.5rem, 7vw, 7rem);
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 30%, transparent);
  }

  .cell-intro :global(.eyebrow) {
    color: var(--color-flame);
  }

  .cell-intro h3 {
    max-width: 37rem;
    margin: clamp(2rem, 3vw, 3rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 5.5vw, 6rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .cell-content {
    min-width: 0;
  }

  .cell-content p {
    max-width: 38rem;
    margin: 0;
    color: color-mix(in srgb, var(--color-ivory) 85%, transparent);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.75;
  }

  .cell-roles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    margin: clamp(3rem, 4vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .cell-roles li {
    padding-block: 1rem 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
    font-size: clamp(0.95rem, 1vw, 1.05rem);
    font-weight: 650;
    line-height: 1.45;
  }

  .cell-roles li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
  }

  .ministries-cta {
    margin-top: clamp(3.5rem, 5vw, 5rem);
  }

  .ministries-cta :global(.button--text) {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .ministries-intro [data-reveal],
  .ministry-list,
  .cell-spotlight [data-reveal],
  .ministries-cta [data-reveal] {
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ministries-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
  .ministry-list.is-reveal-pending:not(.is-revealed),
  .cell-spotlight.is-reveal-pending:not(.is-revealed) [data-reveal],
  .ministries-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
  }

  .intro-heading,
  .cell-content {
    transition-delay: 80ms;
  }

  @media (min-width: 48rem) {
    .cell-roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 4vw, 4rem);
    }

    .cell-roles li:nth-last-child(2) {
      border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
    }
  }

  @media (min-width: 75rem) {
    .ministries-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 6vw, 7rem);
    }

    .ministries-intro {
      position: sticky;
      top: clamp(7.5rem, 10vw, 10rem);
    }

    .cell-spotlight {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 6vw, 7rem);
    }
  }

  @media (max-width: 47.999rem) {
    .ministries {
      padding-block: 5.5rem 6rem;
    }

    .ministries-grid {
      gap: 4.5rem;
    }

    .ministries-marker {
      margin-bottom: 3rem;
    }

    .intro-heading {
      font-size: clamp(3.35rem, 11vw, 4.8rem);
    }

    .ministry-list li {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 1rem;
      padding-block: 1.7rem 1.85rem;
    }

    .ministry-name {
      font-size: clamp(2.5rem, 9vw, 3.65rem);
    }

    .cell-spotlight {
      gap: 2.5rem;
      margin-top: 6rem;
      padding-top: 4rem;
    }

    .cell-intro h3 {
      font-size: clamp(3.2rem, 10vw, 4.75rem);
    }

    .cell-content p {
      font-size: 1rem;
    }

    .cell-roles {
      margin-top: 3rem;
    }

    .ministries-cta {
      margin-top: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ministries-intro [data-reveal],
    .ministry-list,
    .cell-spotlight [data-reveal],
    .ministries-cta [data-reveal] {
      transition: none;
    }

    .ministries-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
    .ministry-list.is-reveal-pending:not(.is-revealed),
    .cell-spotlight.is-reveal-pending:not(.is-revealed) [data-reveal],
    .ministries-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
