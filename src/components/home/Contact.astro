---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { contactCategories } from "../../data/contact";
import { slugify } from "../../utils/slugify";
---

<section class="contact" aria-labelledby="contact-title">
  <Container>
    <div class="contact-grid">
      <div class="contact-intro" data-reveal-group>
        <h2 id="contact-title" class="visually-hidden">Contact</h2>
        <div class="contact-marker" data-reveal>
          <Eyebrow>11 / CONTACT</Eyebrow>
        </div>
        <p class="intro-heading" data-reveal>Connect with Huios.</p>
      </div>

      <div class="contact-options">
        <ul class="contact-list" data-reveal-group>
          {contactCategories.map((category) => (
            <li>
              <span class="contact-number" aria-hidden="true">{category.number}</span>
              <a class="contact-label" href={`/contact/#${slugify(category.label)}`}>{category.label}</a>
            </li>
          ))}
        </ul>

        <div class="contact-cta" data-reveal-group>
          <div data-reveal>
            <Button href="/contact/" variant="text">
              CONTACT HUIOS <span aria-hidden="true">→</span>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Links to the matching section on the inner page; styled like the approved list items. */
  a.contact-label {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  a.contact-label:hover {
    color: var(--color-earth);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .contact {
    --button-hover-color: var(--color-earth);
    padding-block: clamp(6rem, 8.5vw, 9rem) clamp(7rem, 9vw, 10rem);
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(4.5rem, 7vw, 7rem);
    align-items: start;
  }

  .contact-marker {
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .contact-marker :global(.eyebrow) {
    color: var(--color-earth);
  }

  .intro-heading {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.25rem, 6.5vw, 6.5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .contact-list {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-options {
    min-width: 0;
  }

  .contact-list li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: baseline;
    min-width: 0;
    padding-block: clamp(1.65rem, 2.4vw, 2.5rem);
    border-top: 1px solid var(--color-border);
  }

  .contact-list li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .contact-number {
    color: var(--color-earth);
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.16em;
  }

  .contact-label {
    min-width: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 3.4vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .contact-cta {
    margin-top: clamp(4rem, 6vw, 6rem);
  }

  .contact-cta :global(.button--text) {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  .contact-intro [data-reveal],
  .contact-list,
  .contact-cta [data-reveal] {
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
  .contact-list.is-reveal-pending:not(.is-revealed),
  .contact-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
  }

  .intro-heading {
    transition-delay: 80ms;
  }

  @media (min-width: 75rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 6vw, 7rem);
    }
  }

  @media (max-width: 47.999rem) {
    .contact {
      padding-block: 5.5rem 6rem;
    }

    .contact-grid {
      gap: 4.5rem;
    }

    .contact-marker {
      margin-bottom: 3rem;
    }

    .intro-heading {
      font-size: clamp(3.5rem, 12vw, 5rem);
    }

    .contact-list li {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 1rem;
      padding-block: 1.65rem 1.8rem;
    }

    .contact-label {
      font-size: clamp(2.5rem, 9vw, 3.5rem);
    }

    .contact-cta {
      margin-top: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-intro [data-reveal],
    .contact-list,
    .contact-cta [data-reveal] {
      transition: none;
    }

    .contact-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
    .contact-list.is-reveal-pending:not(.is-revealed),
    .contact-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
