---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { primaryNavigation } from "../../data/navigation";
import { departments } from "../../data/departments";
---

<!-- Homepage teaser: the four departments; mandates, offices and summaries live on /our-model/. -->
<section class="departments" aria-labelledby="departments-title">
  <Container>
    <div class="departments-intro" data-reveal-group>
      <h2 id="departments-title" class="sr-only">Our Departments</h2>
      <div class="departments-marker" data-reveal-item>
        <Eyebrow>06 / OUR DEPARTMENTS</Eyebrow>
      </div>
      <p class="intro-heading" data-reveal-item style="--reveal-order: 1">The structure behind the mission.</p>
    </div>

    <ol class="department-list" data-reveal-group>
      {departments.map((department, index) => (
        <li data-reveal-item style={`--reveal-order: ${index}`}>
          <a href={`/our-model/#${department.stage.toLowerCase()}`}>
            <span class="department-stage">{department.number} / {department.stage}</span>
            <span class="department-name">{department.name}</span>
            <span class="department-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="department-cta" data-reveal-group>
      <div data-reveal-item>
        <Button href={primaryNavigation[1].href} variant="text">
          EXPLORE OUR MODEL <span aria-hidden="true">→</span>
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .departments {
    --focus-color: var(--color-flame);
    --button-hover-color: var(--color-flame);
    --rule: color-mix(in srgb, var(--color-paper) 20%, transparent);
    padding-block: clamp(6rem, 8.5vw, 9rem);
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .departments-marker {
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .departments-marker :global(.eyebrow) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-ivory);
  }

  .departments-marker :global(.eyebrow)::before {
    flex: none;
    width: 1.5rem;
    height: 1px;
    background: var(--color-flame);
    content: "";
  }

  .intro-heading {
    max-width: 60rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 6vw, 6.5rem);
    font-weight: 500;
    line-height: 0.93;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .department-list {
    margin: clamp(4rem, 6vw, 6rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .department-list li {
    border-bottom: 1px solid var(--rule);
  }

  .department-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.6rem 1.5rem;
    padding-block: clamp(1.6rem, 2.6vw, 2.4rem);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .department-stage {
    grid-column: 1 / -1;
    color: var(--color-flame);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .department-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .department-arrow {
    color: var(--color-flame);
    font-size: 1.4rem;
    transition: transform 180ms ease;
  }

  .department-list a:hover {
    color: var(--color-flame);
  }

  .department-list a:hover .department-arrow {
    transform: translateX(0.3rem);
  }

  .department-cta {
    margin-top: clamp(3rem, 4.5vw, 4.5rem);
  }

  .department-cta :global(.button--text) {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.09em;
  }

  @media (min-width: 75rem) {
    .department-list a {
      grid-template-columns: 10rem minmax(0, 1fr) auto;
    }

    .department-stage {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .department-list a,
    .department-arrow {
      transition: none;
    }
  }
</style>
