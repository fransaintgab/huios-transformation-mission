---
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import { participationPathways } from "../../data/getInvolved";
import { slugify } from "../../utils/slugify";
---

<section class="get-involved" aria-labelledby="get-involved-title">
  <Container>
    <div class="involvement-grid">
      <div class="involvement-intro" data-reveal-group>
        <h2 id="get-involved-title" class="visually-hidden">Get Involved</h2>
        <div class="involvement-marker" data-reveal>
          <Eyebrow>10 / GET INVOLVED</Eyebrow>
        </div>
        <p class="intro-heading" data-reveal>Become part of the mission.</p>
        <p class="source-intro" data-reveal>There are multiple pathways to become part of the mission:</p>
      </div>

      <ul class="pathway-list" data-reveal-group>
        {participationPathways.map((pathway) => (
          <li>
            <span class="pathway-number" aria-hidden="true">{pathway.number}</span>
            <a class="pathway-label" href={`/get-involved/#${slugify(pathway.label)}`}>{pathway.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="involvement-cta" data-reveal-group>
      <a href="/get-involved/" class="cta-band" data-reveal>
        <span>JOIN THE MISSION</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </Container>
</section>

<style>
  /* Links to the matching section on the inner page; styled like the approved list items. */
  a.pathway-label {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  a.pathway-label:hover {
    color: var(--color-flame);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .get-involved {
    --focus-color: var(--color-flame);
    padding-block: clamp(6rem, 8.5vw, 9rem) clamp(7rem, 9vw, 10rem);
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .involvement-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(4.5rem, 7vw, 7rem);
    align-items: start;
  }

  .involvement-marker {
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }

  .involvement-marker :global(.eyebrow) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-ivory);
  }

  .involvement-marker :global(.eyebrow)::before {
    flex: none;
    width: 1.5rem;
    height: 1px;
    background: var(--color-flame);
    content: "";
  }

  .intro-heading {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 6.5vw, 6.5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .source-intro {
    max-width: 27rem;
    margin: clamp(2.5rem, 4vw, 4rem) 0 0;
    color: color-mix(in srgb, var(--color-ivory) 82%, transparent);
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    line-height: 1.7;
  }

  .pathway-list {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pathway-list li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: baseline;
    min-width: 0;
    padding-block: clamp(1.6rem, 2.3vw, 2.4rem);
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
  }

  .pathway-list li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
  }

  .pathway-number {
    color: var(--color-flame);
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.16em;
  }

  .pathway-label {
    min-width: 0;
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }

  .involvement-cta {
    margin-top: clamp(6rem, 9vw, 9rem);
  }

  .cta-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    min-height: clamp(7.5rem, 11vw, 11rem);
    padding: clamp(1.75rem, 3vw, 3rem);
    background: var(--color-ember);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: clamp(1.35rem, 2.4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .cta-band:hover {
    background: color-mix(in srgb, var(--color-ember) 85%, var(--color-flame));
  }

  .cta-band:focus-visible {
    outline: 3px solid var(--color-flame);
    outline-offset: 5px;
  }

  .cta-arrow {
    flex: none;
    font-size: clamp(2rem, 3.5vw, 3.75rem);
    font-weight: 500;
    line-height: 1;
    transition: transform 220ms ease;
  }

  .cta-band:hover .cta-arrow,
  .cta-band:focus-visible .cta-arrow {
    transform: translateX(0.4rem);
  }

  .involvement-intro [data-reveal],
  .pathway-list,
  .involvement-cta [data-reveal] {
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1), background-color 220ms ease;
  }

  .involvement-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
  .pathway-list.is-reveal-pending:not(.is-revealed),
  .involvement-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
  }

  .intro-heading,
  .source-intro {
    transition-delay: 80ms;
  }

  @media (min-width: 75rem) {
    .involvement-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(3rem, 6vw, 7rem);
    }
  }

  @media (max-width: 47.999rem) {
    .get-involved {
      padding-block: 5.5rem 6rem;
    }

    .involvement-grid {
      gap: 4.5rem;
    }

    .involvement-marker {
      margin-bottom: 3rem;
    }

    .intro-heading {
      font-size: clamp(3.5rem, 12vw, 5rem);
    }

    .source-intro {
      margin-top: 2.5rem;
      font-size: 1rem;
    }

    .pathway-list li {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 1rem;
      padding-block: 1.65rem 1.8rem;
    }

    .pathway-label {
      font-size: clamp(1.35rem, 5.5vw, 1.55rem);
    }

    .involvement-cta {
      margin-top: 5rem;
    }

    .cta-band {
      min-height: 7.5rem;
      padding: 1.5rem;
      font-size: clamp(1.15rem, 5vw, 1.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .involvement-intro [data-reveal],
    .pathway-list,
    .involvement-cta [data-reveal],
    .cta-band,
    .cta-arrow {
      transition: none;
    }

    .involvement-intro.is-reveal-pending:not(.is-revealed) [data-reveal],
    .pathway-list.is-reveal-pending:not(.is-revealed),
    .involvement-cta.is-reveal-pending:not(.is-revealed) [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>
